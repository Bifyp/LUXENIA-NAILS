# Copy to .env for development; do not commit real credentials.
DATABASE_URL="file:./dev.db"
AUTH_URL="http://localhost:3000"
# Generate your own: openssl rand -base64 48
AUTH_SECRET=""

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
ADMIN_EMAIL=""
# Used only by npm run seed; remove from runtime after administrator creation.
ADMIN_PASSWORD=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
DEEPL_API_KEY=""

# Required in production. Development uses a bounded in-process fallback.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Enable only behind a proxy that overwrites forwarded headers and prevents direct access.
TRUST_PROXY="0"
INTERNAL_LOG_SECRET=""
LOG_LEVEL="info"
